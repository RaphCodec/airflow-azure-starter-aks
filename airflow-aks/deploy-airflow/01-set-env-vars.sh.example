random=$(echo $RANDOM | tr '[0-9]' '[a-z]')
export RESOURCE_LOCATION=eastus2
export RESOURCE_GROUP_NAME=my-airflow-rg

# Identity
export IDENTITY_NAME=my-airflow-identity-123

# Container registry (use full login server)
export ACR_REGISTRY=myairflowacr

# Key Vault
export KEYVAULT_NAME=my-vault

# AKS cluster
export CLUSTER_NAME=my-cluster
export AKS_AIRFLOW_NAMESPACE=airflow-demo
export AKS_AIRFLOW_CLUSTER_NAME=my-cluster

# Networking
export VNET_NAME=my-vnet

# Storage (ADLS Gen2) used for logs/landing
export AKS_AIRFLOW_LOGS_STORAGE_ACCOUNT_NAME=myairflowadlsgen2
export AKS_AIRFLOW_LOGS_STORAGE_CONTAINER_NAME=airflow-logs
export AKS_AIRFLOW_LOGS_STORAGE_SECRET_NAME=storage-account-credentials

# Additional services
export POSTGRES_SERVER_NAME=my-pg-server
export REDIS_CACHE_NAME=my-redis-cache

# Service account
export SERVICE_ACCOUNT_NAME=airflow
export SERVICE_ACCOUNT_NAMESPACE=airflow

# AAD (sensitive) - Replace with your actual values
export AAD_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
export AAD_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
export AAD_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

echo "Environment variables set."
